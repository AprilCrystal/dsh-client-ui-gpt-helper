{
  "name": "dsh-client-ui-gpt-helper",
  "version": "0.2.0",
  "description": "ChatGPT-desktop-style model selection and thinking-level control for the DeepSeek Harness Web composer, with an animated fast-mode particle trail, a persistent fast-mode lock, and themeable colours",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "client-plugin",
    "ui",
    "composer",
    "model-selection",
    "reasoning-effort",
    "theming"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AprilCrystal/dsh-client-ui-gpt-helper.git"
  },
  "homepage": "https://github.com/AprilCrystal/dsh-client-ui-gpt-helper#readme",
  "bugs": {
    "url": "https://github.com/AprilCrystal/dsh-client-ui-gpt-helper/issues"
  },
  "author": "AprilCrystal",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "validate": "node scripts/validate-plugin.mjs .",
    "selfcheck": "node scripts/selfcheck.mjs",
    "contrast": "node scripts/contrast.mjs",
    "loadcheck": "node scripts/loadcheck.mjs",
    "check": "npm run validate && npm run loadcheck && npm run selfcheck && npm run contrast",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  }
}
